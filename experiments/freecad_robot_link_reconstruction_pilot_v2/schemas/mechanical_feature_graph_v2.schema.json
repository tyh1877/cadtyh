{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RobotCAD Mechanical Feature Graph v2",
  "type": "object",
  "required": [
    "case_id",
    "link_id",
    "functional_role",
    "kinematic_context",
    "primary_features",
    "functional_features",
    "structural_features",
    "surface_features",
    "feature_dependencies",
    "visual_evidence_refs",
    "interface_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string"},
    "link_id": {"type": "string"},
    "functional_role": {"type": "string"},
    "kinematic_context": {"type": "object"},
    "primary_features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "functional_features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "structural_features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "surface_features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "feature_dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "visual_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "interface_refs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "anchor": {
      "type": "object",
      "required": ["type", "position"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["link_local_normalized", "link_local_mm"]},
        "position": {"$ref": "#/$defs/vec3"},
        "reason": {"type": "string"}
      }
    },
    "local_frame": {
      "type": "object",
      "required": ["x_axis", "y_axis", "z_axis"],
      "additionalProperties": false,
      "properties": {
        "x_axis": {"$ref": "#/$defs/vec3"},
        "y_axis": {"$ref": "#/$defs/vec3"},
        "z_axis": {"$ref": "#/$defs/vec3"}
      }
    },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {"type": "number"},
          {"type": "string"},
          {"type": "boolean"},
          {"type": "array", "items": {"type": "number"}}
        ]
      }
    },
    "attachment": {
      "type": "object",
      "required": ["attached_to", "attachment_face"],
      "additionalProperties": false,
      "properties": {
        "attached_to": {"type": ["string", "null"]},
        "attachment_face": {"type": ["string", "null"]},
        "relation": {"type": "string"}
      }
    },
    "modifier_intent": {
      "type": "object",
      "required": ["parameter_mode", "strength", "requires_translator_resolution"],
      "additionalProperties": false,
      "properties": {
        "modifier_type": {"type": "string", "enum": ["fillet", "chamfer"]},
        "parameter_mode": {"type": "string", "enum": ["relative", "absolute", "unknown"]},
        "strength": {"type": "string", "enum": ["small_finishing", "medium_structural", "unknown"]},
        "safe_ratio_to_local_thickness": {"type": "number", "minimum": 0, "maximum": 0.25},
        "max_ratio_to_edge_length": {"type": "number", "minimum": 0, "maximum": 0.25},
        "requested_radius_mm": {"type": "number"},
        "requested_distance_mm": {"type": "number"},
        "requires_translator_resolution": {"type": "boolean"},
        "evidence_notes": {"type": "string"}
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "feature_id",
        "feature_type",
        "priority",
        "role",
        "evidence",
        "anchor",
        "local_frame",
        "dimensions",
        "attachment",
        "visible_evidence_refs",
        "intended_cad_operation",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "feature_id": {"type": "string"},
        "feature_type": {"type": "string"},
        "priority": {"type": "string", "enum": ["primary", "functional", "structural", "surface"]},
        "role": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "anchor": {"$ref": "#/$defs/anchor"},
        "local_frame": {"$ref": "#/$defs/local_frame"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "attachment": {"$ref": "#/$defs/attachment"},
        "visible_evidence_refs": {"type": "array", "items": {"type": "string"}},
        "intended_cad_operation": {
          "type": "string",
          "enum": ["extrude", "pad", "pocket", "cut", "revolve", "loft", "sweep", "pipe", "shell", "thickness", "boolean_union", "boolean_cut", "fillet", "chamfer", "pattern", "mirror", "none"]
        },
        "shape_family": {"type": "string"},
        "modifier_intent": {"$ref": "#/$defs/modifier_intent"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "dependency": {
      "type": "object",
      "required": ["source", "target", "relation"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "target": {"type": "string"},
        "relation": {"type": "string"}
      }
    }
  }
}
