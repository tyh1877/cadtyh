{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Try-6 R1 canonical KFDG assembled from authoritative backbone and VFP",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "link_id", "functional_nodes", "geometric_features", "parameters", "constraints", "metric_anchor", "authority"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["robotcad_kfdg_r1"]},
    "link_id": {"type": "string", "enum": ["L04"]},
    "functional_nodes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "type", "joint_id", "frame_xyz_mm", "axis", "interface_family", "source"], "properties": {"id": {"type": "string"}, "type": {"type": "string", "enum": ["joint_port", "mount_port"]}, "joint_id": {"type": "string", "enum": ["J03", "J04"]}, "frame_xyz_mm": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "axis": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "interface_family": {"type": "string"}, "source": {"type": "string", "enum": ["URDF_AND_FROZEN_INTERFACE"]}}}},
    "geometric_features": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["id", "type", "parameter_refs", "source_local_name", "evidence_views", "confidence"], "properties": {"id": {"type": "string"}, "type": {"type": "string", "enum": ["housing", "pocket", "profile_transition"]}, "parameter_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "source_local_name": {"type": "string"}, "evidence_views": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]}}}},
    "parameters": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object", "additionalProperties": false, "required": ["id", "value", "unit", "lower_bound", "upper_bound", "provenance", "confidence", "owner_feature_id", "semantic_role", "optimizable", "functional_frozen", "allowed_orphan"], "properties": {"id": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string", "enum": ["mm"]}, "lower_bound": {"type": "number"}, "upper_bound": {"type": "number"}, "provenance": {"type": "string", "enum": ["VISUAL_EVIDENCE", "URDF_METRIC_ANCHOR", "KINEMATIC_REQUIREMENT", "SOLVER_ESTIMATED"]}, "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]}, "owner_feature_id": {"type": "string"}, "semantic_role": {"type": "string"}, "optimizable": {"type": "boolean"}, "functional_frozen": {"type": "boolean"}, "allowed_orphan": {"type": "boolean"}}}},
    "constraints": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["source", "target", "type"], "properties": {"source": {"type": "string"}, "target": {"type": "string"}, "type": {"type": "string", "enum": ["interface_fixed", "profile_continuity", "contains", "connected_to"]}}}},
    "metric_anchor": {"type": "object", "additionalProperties": false, "required": ["joint_ids", "distance_mm", "source"], "properties": {"joint_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}, "distance_mm": {"type": "number"}, "source": {"type": "string", "enum": ["SANITIZED_URDF_J04_L04_ORIGIN"]}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["functional_backbone_sha256", "parameter_registry_sha256", "assembler_rules_sha256", "vfp_sha256"], "properties": {"functional_backbone_sha256": {"type": "string"}, "parameter_registry_sha256": {"type": "string"}, "assembler_rules_sha256": {"type": "string"}, "vfp_sha256": {"type": "string"}}}
  }
}
