{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mechanical Feature Graph v1",
  "type": "object",
  "required": [
    "case_id",
    "link_id",
    "functional_role",
    "kinematic_context",
    "primary_features",
    "functional_features",
    "structural_features",
    "surface_features",
    "feature_dependencies",
    "visual_evidence_refs",
    "interface_refs"
  ],
  "properties": {
    "case_id": { "type": "string" },
    "link_id": { "type": "string" },
    "functional_role": { "type": "string" },
    "kinematic_context": {
      "type": "object",
      "required": ["proximal_joint", "distal_joint"],
      "properties": {
        "proximal_joint": { "type": ["string", "null"] },
        "distal_joint": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "primary_features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
    "functional_features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
    "structural_features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
    "surface_features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
    "feature_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "visual_evidence_refs": { "type": "array", "items": { "type": "string" } },
    "interface_refs": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "feature_id",
        "feature_type",
        "priority",
        "role",
        "evidence",
        "reference_frame",
        "approx_dimensions",
        "shape_family",
        "cad_strategy",
        "dependencies",
        "confidence"
      ],
      "properties": {
        "feature_id": { "type": "string" },
        "feature_type": { "type": "string" },
        "priority": { "enum": ["primary", "functional", "structural", "surface"] },
        "role": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "reference_frame": { "type": "string" },
        "approx_dimensions": { "type": "object" },
        "shape_family": { "type": "string" },
        "cad_strategy": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
