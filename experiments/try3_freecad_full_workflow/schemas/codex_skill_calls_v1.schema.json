{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex_skill_calls_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "version", "link_id", "calls"],
  "properties": {
    "schema_version": {"const": "codex_skill_calls_v1"},
    "case_id": {"type": "string"}, "version": {"enum": ["V0", "V1", "V2"]},
    "link_id": {"type": "string"},
    "calls": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["call_id", "skill", "parameters", "source_feature_ids", "calling_agent", "no_fallback"],
      "properties": {
        "call_id": {"type": "string"},
        "skill": {"enum": ["CreateParametricLinkEnvelope", "CreateLoftedLinkHousing", "CreateRotaryJointHousing", "CreateFlangeInterface", "BooleanUnion"]},
        "parameters": {"type": "object"},
        "source_feature_ids": {"type": "array", "items": {"type": "string"}},
        "calling_agent": {"enum": ["CodexV0Planner", "CodexV1PerLinkEngineer", "CodexV2MechanicalCADEngineer"]},
        "no_fallback": {"const": true}
      }
    }}
  }
}

