{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "case_id", "link_id", "mechanical_intent", "interface_constraints", "operations"],
  "properties": {
    "schema_version": {"const": "robotcad.operation_plan_pilot.v1"},
    "case_id": {"type": "string"},
    "link_id": {"type": "string", "pattern": "^L[0-9]+$"},
    "mechanical_intent": {
      "type": "object",
      "required": ["role", "geometry_intent", "surface_features"],
      "properties": {
        "role": {"type": "string"},
        "geometry_intent": {"type": "string"},
        "surface_features": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "interface_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["joint_id", "parent_link", "child_link", "constraint"],
        "properties": {
          "joint_id": {"type": "string"},
          "parent_link": {"type": "string", "pattern": "^L[0-9]+$"},
          "child_link": {"type": "string", "pattern": "^L[0-9]+$"},
          "constraint": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "operation_id", "purpose"],
        "properties": {
          "op": {
            "enum": [
              "CreateSketchProfile", "Extrude", "Loft", "Revolve", "Sweep",
              "Shell", "OffsetFace", "BooleanUnion", "BooleanCut",
              "ApplyFillet", "ApplyChamfer", "CreateHole", "CircularPattern",
              "LinearPattern", "Mirror"
            ]
          },
          "operation_id": {"type": "string"},
          "purpose": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "prohibited_input_ack": {"type": "string"}
  },
  "additionalProperties": true
}
