{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "try4_t0_direct_output_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "part_id", "feature_graph", "cad_ir"],
  "properties": {
    "schema_version": {"type": "string", "const": "try4_t0_direct_output_v1"},
    "part_id": {"type": "string", "pattern": "^R01_P[0-9]{2}$"},
    "feature_graph": {"type": "object", "additionalProperties": false, "required": ["features"], "properties": {"features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}}}},
    "cad_ir": {
      "type": "object", "additionalProperties": false,
      "required": ["ir_version", "units", "bodies", "operations", "final_objects", "editable_parameter", "assumptions", "silent_fallback_allowed"],
      "properties": {
        "ir_version": {"type": "string", "const": "try4_executable_cad_ir_v1"}, "units": {"type": "string", "const": "mm"},
        "bodies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/body"}},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
        "final_objects": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^op_[0-9]{3}$"}},
        "editable_parameter": {"$ref": "#/$defs/editable_parameter"}, "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "silent_fallback_allowed": {"type": "boolean", "const": false}
      }
    }
  },
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "vec2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "nullable_vec3": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "nullable_vec2": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "frame": {"type": "object", "additionalProperties": false, "required": ["origin", "x_axis", "y_axis", "z_axis"], "properties": {"origin": {"$ref": "#/$defs/vec3"}, "x_axis": {"$ref": "#/$defs/vec3"}, "y_axis": {"$ref": "#/$defs/vec3"}, "z_axis": {"$ref": "#/$defs/vec3"}}},
    "estimated_dimensions": {"type": "object", "additionalProperties": false, "required": ["length", "width", "depth", "radius", "wall_thickness", "uncertainty_note"], "properties": {"length": {"type": ["number", "null"]}, "width": {"type": ["number", "null"]}, "depth": {"type": ["number", "null"]}, "radius": {"type": ["number", "null"]}, "wall_thickness": {"type": ["number", "null"]}, "uncertainty_note": {"type": "string"}}},
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_id", "requirement_refs", "feature_type", "role", "evidence", "reference_region", "estimated_dimensions_mm", "shape_family", "intended_cad_strategy", "dependencies", "critical", "confidence", "status"],
      "properties": {
        "feature_id": {"type": "string", "pattern": "^F[0-9]{2}$"}, "requirement_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^R01_P[0-9]{2}_E[0-9]{2}$"}},
        "feature_type": {"type": "string"}, "role": {"type": "string", "enum": ["primary", "functional", "structural", "surface", "interface"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^images/(global|isolated)_(front|rear|left|right|side|top|isometric)\\.png$"}},
        "reference_region": {"type": "string"}, "estimated_dimensions_mm": {"$ref": "#/$defs/estimated_dimensions"}, "shape_family": {"type": "string"},
        "intended_cad_strategy": {"type": "string", "enum": ["ORIENTED_BOX", "CYLINDER", "LOFT", "BOOLEAN_UNION", "BOOLEAN_CUT", "FILLET", "CHAMFER", "UNIMPLEMENTED"]},
        "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^F[0-9]{2}$"}}, "critical": {"type": "boolean"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"type": "string", "enum": ["PLANNED", "UNIMPLEMENTED"]}
      }
    },
    "body": {"type": "object", "additionalProperties": false, "required": ["body_id", "role", "feature_ids", "final_object"], "properties": {"body_id": {"type": "string", "pattern": "^B[0-9]{2}$"}, "role": {"type": "string"}, "feature_ids": {"type": "array", "items": {"type": "string", "pattern": "^F[0-9]{2}$"}}, "final_object": {"type": "string", "pattern": "^op_[0-9]{3}$"}}},
    "edge_selector": {"type": "object", "additionalProperties": false, "required": ["selector_type", "max_edges"], "properties": {"selector_type": {"type": "string", "enum": ["outer_long_edges", "outer_short_edges", "circular_edges", "feature_edges", "all_safe_edges"]}, "max_edges": {"type": "integer", "minimum": 1}}},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["op_id", "op_type", "target_body", "dependencies", "reference_frame", "feature_ref", "start", "end", "width_mm", "depth_mm", "center", "axis", "radius_mm", "height_mm", "start_size_mm", "end_size_mm", "tool_bodies", "edge_selectors", "distance_mm", "operation_mode"],
      "properties": {
        "op_id": {"type": "string", "pattern": "^op_[0-9]{3}$"}, "op_type": {"type": "string", "enum": ["oriented_box", "cylinder_primitive", "lofted_prism", "boolean_union", "boolean_cut", "fillet", "chamfer"]},
        "target_body": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string"}}, "reference_frame": {"$ref": "#/$defs/frame"}, "feature_ref": {"type": "string", "pattern": "^F[0-9]{2}$"},
        "start": {"$ref": "#/$defs/nullable_vec3"}, "end": {"$ref": "#/$defs/nullable_vec3"}, "width_mm": {"type": ["number", "null"]}, "depth_mm": {"type": ["number", "null"]},
        "center": {"$ref": "#/$defs/nullable_vec3"}, "axis": {"$ref": "#/$defs/nullable_vec3"}, "radius_mm": {"type": ["number", "null"]}, "height_mm": {"type": ["number", "null"]},
        "start_size_mm": {"$ref": "#/$defs/nullable_vec2"}, "end_size_mm": {"$ref": "#/$defs/nullable_vec2"}, "tool_bodies": {"type": "array", "items": {"type": "string"}},
        "edge_selectors": {"type": "array", "items": {"$ref": "#/$defs/edge_selector"}}, "distance_mm": {"type": ["number", "null"]}, "operation_mode": {"type": ["string", "null"], "enum": ["new_body", null]}
      }
    },
    "editable_parameter": {"type": "object", "additionalProperties": false, "required": ["object_id", "property", "baseline_value", "edit_fraction"], "properties": {"object_id": {"type": "string", "pattern": "^op_[0-9]{3}$"}, "property": {"type": "string", "enum": ["Length", "Width", "Height", "Radius"]}, "baseline_value": {"type": "number", "exclusiveMinimum": 0}, "edit_fraction": {"type": "number", "const": 0.05}}}
  }
}
