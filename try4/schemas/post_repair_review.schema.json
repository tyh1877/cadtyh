{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["part_id","round","semantic_role_pass","lod_pass","visible_feature_pass","overall_pass","recommended_state","evidence","reviewer"],
  "properties":{
    "part_id":{"pattern":"^R0[12]_P[0-9]{2}$"},"round":{"type":"integer","minimum":1,"maximum":3},
    "semantic_role_pass":{"type":"boolean"},"lod_pass":{"type":"boolean"},"visible_feature_pass":{"type":"boolean"},"overall_pass":{"type":"boolean"},
    "recommended_state":{"enum":["PASS","LOCAL_REPAIR","REPLAN"]},"evidence":{"type":"array","minItems":1,"items":{"type":"string"}},"reviewer":{"const":"current_interactive_codex"}
  },"additionalProperties":false
}
