{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper/go_nogo2/prediction_contract.schema.json",
  "title": "Go/No-Go 2 common prediction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "method", "case_id", "status", "prompt_sha256",
    "image_sha256", "attempts", "artifacts", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "method": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^case_[0-9]{2}_arm-[a-f0-9]{10}$"},
    "status": {"enum": ["SUCCESS", "FAILURE", "NOT_RUN"]},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image_sha256": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "attempts": {"type": "integer", "minimum": 0},
    "latency_seconds": {"type": ["number", "null"], "minimum": 0},
    "budget": {
      "type": "object",
      "required": ["max_total_output_tokens", "max_total_model_tokens", "max_repair_iterations", "api_calls", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "max_total_output_tokens": {"type": "integer", "minimum": 1},
        "max_total_model_tokens": {"type": "integer", "minimum": 1},
        "max_repair_iterations": {"type": "integer", "minimum": 0},
        "api_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["raw_response", "prediction_urdf", "link_mesh_directory"],
      "properties": {
        "raw_response": {"type": ["string", "null"]},
        "prediction_urdf": {"type": ["string", "null"]},
        "link_mesh_directory": {"type": ["string", "null"]},
        "editable_cad": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["implementation_version", "model", "request_id", "output_sha256"],
      "properties": {
        "implementation_version": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "request_id": {"type": ["string", "null"]},
        "output_sha256": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "error": {"type": ["string", "null"]}
  }
}
